GEMINI_API_KEYS=
GEMINI_KEY_PROJECTS=
GEMINI_MODEL=gemini-2.5-flash
NEWS_DELIVERY=telegram
NEWS_TELEGRAM_BOT_TOKEN=
NEWS_TELEGRAM_CHAT_ID=
NEWS_LEARNING_START_DATE=2026-10-15
NEWS_FINANCE_START_DATE=2026-10-15
# Optional legacy email delivery:
NEWS_SMTP_USER=
NEWS_SMTP_PASSWORD=
NEWS_EMAIL_TO=

# Separate AI edition: fixed public feeds plus approved Gmail newsletter issues
AI_NEWSLETTER_ENABLED=true
NEWSLETTER_IMAP_ENABLED=false
NEWSLETTER_IMAP_USER=
NEWSLETTER_IMAP_PASSWORD=
# Exact From addresses only for publishers using shared email platforms:
NEWSLETTER_ALLOWED_SENDERS=

# Targeted primary-source follow-up across five daily news editions:
NEWS_RESEARCH_ENABLED=true

# Five-minute news on Telegram; detailed HTML news by email. Finance Class stays long.
NEWS_BRIEF_MODE=short
NEWS_DETAIL_EMAIL_ENABLED=false
NEWS_DETAIL_EMAIL_TO=
# Report SMTP defaults to the same Gmail account/app password used for newsletter intake.
# Optional explicit overrides:
NEWS_REPORT_SMTP_USER=
NEWS_REPORT_SMTP_PASSWORD=
# External cron-job.org account key and repo-limited GitHub Actions dispatch token (local setup only):
NEWS_CRON_API_KEY=
NEWS_CRON_GITHUB_TOKEN=
