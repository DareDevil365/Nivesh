# Optional local settings. No external credentials are required.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
# Leave blank to use a generated local signing secret.
SESSION_SECRET=
COOKIE_SECURE=false
# Optional durable directory for hosted use:
# NIVESH_DATA_DIR=
# Optional cache transports; leave unset for local cache:
# Optional AI research, called only when Generate deep dive is clicked:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# REDIS_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional comma-separated credentials and matching project labels:
# GEMINI_API_KEYS=
# GEMINI_KEY_PROJECTS=

# Standalone hosted news bot. Gmail app password, never your normal password.
# Store these as GitHub Actions secrets for hosted execution.
# NEWS_SMTP_HOST=smtp.gmail.com
# NEWS_SMTP_PORT=465
# NEWS_SMTP_USER=
# NEWS_SMTP_PASSWORD=
# NEWS_EMAIL_TO=

# Personal Telegram news delivery; pair the private chat with setup_telegram.py.
NEWS_DELIVERY=telegram
NEWS_TELEGRAM_BOT_TOKEN=
NEWS_TELEGRAM_CHAT_ID=
NEWS_LEARNING_START_DATE=2026-10-15
# Broad Finance Class start; Stock Daddy uses NEWS_LEARNING_START_DATE.
NEWS_FINANCE_START_DATE=2026-10-15
